# Copy this file to .env (in this folder) and fill in your own key.
# Never commit the real .env.

# Portkey API key. Every agent calls gpt-6-luna through https://api.portkey.ai/v1
PORTKEY_API_KEY=your_portkey_api_key_here

# Optional: point the React board at a different backend (default http://localhost:8000)
# VITE_API_URL=http://localhost:8000
